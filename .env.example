# ---------------------------------------------------------------------------
# Cosy Crest — Environment template
# Copy to `.env.local` for local development and set the same keys in Vercel.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase (public — safe to expose to the browser) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only — NEVER prefix with NEXT_PUBLIC_) ---------------
# Required by the Paystack webhook so it can write booking status server-side
# while bypassing Row Level Security. Find it in
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack --------------------------------------------------------------
# NOTE: the current flow redirects to Paystack's hosted page, so the public key
# is not read by any code. It is kept here for a future inline-checkout switch.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Secret key must only ever be read server-side (initialize + webhook + verify).
PAYSTACK_SECRET_KEY=sk_test_xxx

# --- Email (receipts) ------------------------------------------------------
# Uses Resend (https://resend.com). Without RESEND_API_KEY the site works
# normally — the guest simply does not receive a receipt email.
RESEND_API_KEY=re_xxx
# Must be an address on a domain you have verified with Resend.
# Format: "Display Name <receipts@yourdomain.com>"
RECEIPT_FROM_EMAIL=Cosy Crest <receipts@yourdomain.com>

# --- Application -----------------------------------------------------------
# Absolute origin used for the Paystack callback_url, the receipt link in
# emails, and every SEO surface (canonical URLs, Open Graph images, robots.txt,
# sitemap.xml).
#
# Locally:     http://localhost:3000
# Production:  https://cosycrest.com   <- your primary host, no trailing slash
#
# Getting this wrong in production points every canonical at the wrong host,
# which actively suppresses ranking. If you serve www, use that here instead —
# but pick one and 301 the other, or the site splits into two copies.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
