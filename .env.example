# ---------------------------------------------------------------------------
# Cosy Crest — Environment template
# Copy to `.env.local` for local development and set the same keys in Vercel.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase (public — safe to expose to the browser) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only — NEVER prefix with NEXT_PUBLIC_) ---------------
# Required by the Paystack webhook so it can write booking status server-side
# while bypassing Row Level Security. Find it in
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack --------------------------------------------------------------
# NOTE: the current flow redirects to Paystack's hosted page, so the public key
# is not read by any code. It is kept here for a future inline-checkout switch.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Secret key must only ever be read server-side (initialize + webhook + verify).
PAYSTACK_SECRET_KEY=sk_test_xxx

# --- Email (receipts) ------------------------------------------------------
# Uses Resend (https://resend.com). Without RESEND_API_KEY the site works
# normally — the guest simply does not receive a receipt email.
RESEND_API_KEY=re_xxx
# Must be an address on a domain you have verified with Resend.
# Format: "Display Name <receipts@yourdomain.com>"
RECEIPT_FROM_EMAIL=Cosy Crest <receipts@yourdomain.com>

# --- Admin access ----------------------------------------------------------
# Comma-separated allowlist of email addresses permitted into /admin.
#
# Without this, NOBODY can reach /admin. That is deliberate. The admin panel can
# read every guest's name, email and phone number, and can edit prices and
# availability — so it fails closed rather than open.
#
# The old behaviour was to admit anyone holding *a* Supabase session, which on a
# project with public signup enabled meant anyone at all. See middleware.ts and
# supabase/admin-role.sql.
#
# The address here must be the same one you set the `admin` role on in
# supabase/admin-role.sql (either mechanism alone is sufficient, both is better).
ADMIN_EMAILS=officialcosycrestaparts@gmail.com

# --- Application -----------------------------------------------------------
# Absolute origin used for the Paystack callback_url, the receipt link in
# emails, and every SEO surface (canonical URLs, Open Graph images, robots.txt,
# sitemap.xml).
#
# Locally:     http://localhost:3000
# Production:  https://www.cosycrest.com   <- your primary host, no trailing slash
#
# PICK ONE HOST and make the other permanently redirect to it. The site currently
# 308-redirects cosycrest.com -> www.cosycrest.com, so the value above must be
# the www host: every canonical tag and every sitemap entry is built from it, and
# a canonical that points at a redirecting URL is discarded by Google as
# "Page with redirect".
#
# If you would rather serve the apex domain, change the Vercel domain redirect
# instead and set this to https://cosycrest.com — but change only one of the two,
# never both, or the site splits into two competing copies of itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
